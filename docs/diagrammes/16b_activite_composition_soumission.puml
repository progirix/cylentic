@startuml
skinparam shadowing false
skinparam ActivityBorderColor #333333
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityDiamondBackgroundColor #FFFFFF

title Diagramme d'activité 2/2 : Composition, incidents et soumission

start

note right
  Suite du diagramme
  d'activité 1/2
end note

:Passer en phase de composition;

repeat
  :Répondre aux exercices code et QCM;
  :Sauvegarder automatiquement le code;

  if (Exécution demandée ?) then (oui)
    :Exécuter le code dans le sandbox;
    :Afficher la sortie;
  else (non)
  endif

  if (Incident détecté ?) then (oui)
    :Enregistrer l'incident;
    if (Seuil d'exclusion atteint ?) then (oui)
      :Soumettre la copie avec exclusion;
    else (non)
      :Avertir et exiger le retour en plein écran si besoin;
    endif
  else (non)
  endif
repeat while (Fin de composition ?\nsoumission, timer ou exclusion) is (non)

:Corriger automatiquement les soumissions;
:Afficher la confirmation de fin d'examen;

stop

@enduml
