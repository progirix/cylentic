@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods
hide circle

title Diagramme de classes : Organisation et comptes

class PlatformAdmin {
  id
  identifier
  email
  firstName
  lastName
  passwordHash
  isActive
  lastLoginAt
}

class SubscriptionPlan {
  id
  code
  name
  maxTeachers
  maxStudents
  maxExamsPerMonth
  priceMin
  priceMax
  currency
  isActive
}

class Establishment {
  id
  name
  acronym
  type
  country
  city
  timezone
  officialEmail
  phone
  isActive
}

class EstablishmentSubscription {
  id
  status
  isSimulated
  trialEndsAt
  startedAt
  currentPeriodEnd
}

class AcademicYear {
  id
  label
  startDate
  endDate
  isActive
  isArchived
}

class Class {
  id
  name
  track
  level
  isArchived
}

class User {
  id
  identifier
  role
  email
  firstName
  lastName
  passwordHash
  mustChangePassword
  isActive
  lastLoginAt
}

class AdminProfile {
  function
}

class TeacherProfile {
  subjects
  function
}

class StudentProfile {
  matricule
}

class AdminActivityLog {
  id
  action
  entityType
  entityId
  createdAt
}

PlatformAdmin "1" -- "0..*" Establishment : "administre"
SubscriptionPlan "1" -- "0..*" EstablishmentSubscription : "définit"
Establishment "1" -- "0..*" EstablishmentSubscription : "souscrit"
Establishment "1" -- "0..*" AcademicYear : "organise"
Establishment "1" -- "0..*" Class : "regroupe"
Establishment "1" -- "0..*" User : "emploie"
Establishment "1" -- "0..*" AdminActivityLog : "journalise"
User "1" -- "0..1" AdminProfile : "possède"
User "1" -- "0..1" TeacherProfile : "possède"
User "1" -- "0..1" StudentProfile : "possède"
User "0..1" -- "0..*" AdminActivityLog : "réalise"
Class "1" -- "0..*" StudentProfile : "accueille"
AcademicYear "1" -- "0..*" StudentProfile : "concerne"

@enduml
