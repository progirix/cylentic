@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods
hide circle

title Diagramme de classes : Examens, soumissions et incidents

class Establishment {
  id
  name
  acronym
}

class User {
  id
  identifier
  role
}

class Class {
  id
  name
}

class Exam {
  id
  name
  status
  startAt
  durationMinutes
  accessDelayMinutes
  correctionMode
  accessCode
  maxIncidentsBeforeClose
  publishedAt
  startedAt
  endedAt
}

class ExamClass {
}

class Exercise {
  id
  type
  title
  statement
  language
  points
  correctionMode
  orderIndex
}

class UnitTest {
  id
  input
  expectedOutput
  weight
  isHidden
  orderIndex
}

class QcmQuestion {
  id
  text
  answerType
  points
  explanation
  orderIndex
}

class QcmChoice {
  id
  text
  isCorrect
  orderIndex
}

class ExamParticipation {
  id
  status
  isCompleted
  connectedAt
  ipAddress
  waitingRoomEnteredAt
  startedAt
  submittedAt
  submissionReason
  autoScore
  manualScore
  finalScore
}

class Submission {
  id
  sourceCode
  language
  autoScore
  manualScore
  finalScore
  comment
  submittedAt
}

class SubmissionTestResult {
  id
  passed
  actualOutput
  stderr
  status
  timeMs
  memoryKb
}

class QcmAnswer {
  id
}

class CodeAutosave {
  id
  content
  savedAt
}

class Incident {
  id
  type
  occurredAt
  durationSeconds
  payload
}

Establishment "1" -- "0..*" Exam : détient
User "1" -- "0..*" Exam : crée
Exam "1" -- "0..*" ExamClass : autorise
Class "1" -- "0..*" ExamClass : participe
Exam "1" -- "0..*" Exercise : contient
Exam "1" -- "0..*" ExamParticipation : regroupe
User "1" -- "0..*" ExamParticipation : compose
Exercise "1" -- "0..*" UnitTest : évalue
Exercise "1" -- "0..*" QcmQuestion : pose
QcmQuestion "1" -- "0..*" QcmChoice : propose
ExamParticipation "1" -- "0..*" Submission : produit
Exercise "1" -- "0..*" Submission : cible
ExamParticipation "1" -- "0..*" CodeAutosave : conserve
Exercise "1" -- "0..*" CodeAutosave : concerne
ExamParticipation "1" -- "0..*" Incident : génère
Submission "1" -- "0..*" SubmissionTestResult : obtient
UnitTest "1" -- "0..*" SubmissionTestResult : vérifie
Submission "1" -- "0..*" QcmAnswer : contient
QcmQuestion "1" -- "0..*" QcmAnswer : reçoit
QcmChoice "1" -- "0..*" QcmAnswer : sélectionne

@enduml
