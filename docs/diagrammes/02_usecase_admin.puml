@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

title Diagramme de cas d'utilisation : Administrateur d'établissement

actor "Administrateur\nd'établissement" as Admin

rectangle "Cylentic" {

  package "Authentification" {
    usecase "Se connecter" as UC1
    usecase "Changer son mot de passe" as UC2
  }

  package "Inscription" {
    usecase "Créer un établissement" as UC3
  }

  package "Configuration initiale" {
    usecase "Compléter la configuration initiale" as UC4
  }

  package "Vue d'ensemble" {
    usecase "Consulter le tableau de bord" as UC5
    usecase "Consulter les statistiques" as UC6
  }

  package "Gestion du référentiel" {
    usecase "Créer une année académique" as UC7
    usecase "Consulter les années académiques" as UC8
    usecase "Créer une classe" as UC9
    usecase "Consulter les classes" as UC10
  }

  package "Gestion des utilisateurs" {
    usecase "Créer un étudiant" as UC11
    usecase "Consulter les étudiants" as UC12
    usecase "Créer un professeur" as UC13
    usecase "Consulter les professeurs" as UC14
  }

  package "Exploitation" {
    usecase "Consulter le journal d'activité" as UC15
    usecase "Consulter l'abonnement" as UC16
    usecase "Changer de plan tarifaire" as UC17
  }
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17

UC5 ..> UC6 : <<include>>
UC17 ..> UC16 : <<include>>
UC4 ..> UC7 : <<include>>
UC4 ..> UC9 : <<include>>
UC4 ..> UC13 : <<include>>

@enduml
