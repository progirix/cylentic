@startuml
top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle

title Diagramme de cas d'utilisation : Administrateur d'établissement

actor "Administrateur\nd'établissement" as Admin

rectangle "Cylentic" {

  package "Authentification" {
    usecase "Se connecter" as UC1
    usecase "Changer son mot de passe" as UC2
  }

  package "Inscription et configuration" {
    usecase "Créer un établissement" as UC3
    usecase "Compléter la configuration initiale" as UC4
  }

  package "Pilotage" {
    usecase "Consulter le tableau de bord" as UC5
    usecase "Consulter le journal d'activité" as UC6
    usecase "Gérer l'abonnement" as UC7
  }

  package "Référentiel et comptes" {
    usecase "Gérer les années académiques" as UC8
    usecase "Gérer les classes" as UC9
    usecase "Gérer les étudiants" as UC10
    usecase "Gérer les professeurs" as UC11
  }
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11

UC4 ..> UC8 : <<include>>
UC4 ..> UC9 : <<include>>
UC4 ..> UC11 : <<include>>

@enduml
