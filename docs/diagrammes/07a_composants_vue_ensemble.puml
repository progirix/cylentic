@startuml
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam nodesep 40
skinparam ranksep 45

title Diagramme de composants 1/3 : Vue d'ensemble

actor "Utilisateur" as User

package "Navigateur" as Nav {
  [Pages et espaces applicatifs] as UI
  [Éditeur Monaco] as Monaco
}

package "Application Next.js" as App {
  [Middleware d'authentification] as MW
  [Couche API] as API
  [Couche métier] as Metier
  [Accès aux données] as Data
  [Workers] as Workers
}

database "MySQL" as DB
database "Redis" as Redis
[Sandbox Docker Python] as Sandbox

User --> UI
UI --> Monaco
UI --> MW
MW --> API
API --> Metier
Metier --> Data
Workers --> Data
Workers --> Metier
Data --> DB
Data --> Redis
Metier --> Sandbox

@enduml
